# Copy to .env and fill in before running docker-compose.
#
# API auth — set to any secret string to protect the FastAPI endpoints.
# Leave blank to disable auth (local dev only).
SOLARSOILED_API_KEY=

# Per-partner key registry — path to a YAML file mapping API keys to partner_ids.
# When set, each key can only read/write its own partner's data.
# When unset, falls back to single-key mode (SOLARSOILED_API_KEY above).
# See keys.example.yaml for the file format.
SOLARSOILED_KEYS_FILE=

# NASA Earthdata token — enables MERRA-2 PM2.5/PM10 backfill (1980-present).
# Without it, AQ features use CAMS (2022-present only).
# Register at https://urs.earthdata.nasa.gov
NASA_EARTHDATA_TOKEN=
